{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production",
        "NODE_VERSION": "20",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "1",
        "EXPO_PUBLIC_API_URL": "https://backend.kuremedi.com/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production",
        "NODE_VERSION": "20",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "1",
        "EXPO_PUBLIC_API_URL": "https://backend.kuremedi.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production",
        "NODE_VERSION": "20",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "1",
        "EXPO_PUBLIC_API_URL": "https://backend.kuremedi.com/api"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production"
      }
    }
  }
}